{
  "name": "conquerspain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juego de estrategia por turnos en la peninsula iberica preindustrial",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "paquetes/*",
    "herramientas/*"
  ],
  "scripts": {
    "tipos": "tsc --build",
    "tipos:limpiar": "tsc --build --clean",
    "lint": "eslint .",
    "formato": "prettier --check .",
    "formato:escribir": "prettier --write .",
    "test": "vitest run",
    "cobertura": "vitest run --coverage",
    "verificar": "npm run tipos && npm run lint && npm run formato && npm run test && npm run atlas:comprobar",
    "partidas": "tsx herramientas/banco/src/regenerar-partidas.ts",
    "atlas": "tsx herramientas/atlas/src/atlas.ts",
    "atlas:comprobar": "tsx herramientas/atlas/src/atlas.ts --comprobar"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
