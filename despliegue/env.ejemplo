# Copia este fichero como .env en la raiz del repositorio del servidor y rellenalo. Nunca va a git.

# La web publica: los enlaces de los correos apuntan aqui.
URL_PUBLICA=https://conquerspain.com
# 32 bytes aleatorios en base64: openssl rand -base64 32
CLAVE_DE_COOKIES=

# El correo saliente (docs/07 §7.8.1). Con Brevo: smtp-relay.brevo.com, 587, starttls.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=ConquerSpain <avisos@conquerspain.com>

# El token del tunel de Cloudflare (Zero Trust > Networks > Tunnels > el tunel > Install connector).
TUNNEL_TOKEN=
