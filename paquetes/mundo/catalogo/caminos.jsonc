      "altitud": 1011,
      "cierre": "invierno",
      "nota": "Paso de los Montes de Pas a Burgos; por él bajaba la lana camino de Santander.",
    },
    {
      "nombre": "Portela do Homem",
      "entre": ["a-limia", "terra-de-barroso"],
      "altitud": 822,
      "cierre": "invierno",
