// Capa historica del grafo de caminos (T-013).
//
// El atlas sabe que comarcas se tocan; esto le dice lo que el mapa no ve: que entre Cameros y
// Soria hay un puerto que la nieve cierra, que el Duero se vadea en Toro, que la Via de la Plata
// sigue siendo el mejor camino de la peninsula y que por la Canyada Soriana Occidental bajan cada
// otonyo los rebanyos de Urbion hasta la Serena.
//
// Las rutas (calzadas y canyadas) se escriben como **secuencias de comarcas contiguas**: cada par
// consecutivo tiene que ser vecino en el grafo, y el validador lo comprueba.
{
  // --- Puertos de montanya (docs/05-geografia.md §5.3) --------------------------------------
  // `cierre: "invierno"` los hace intransitables de diciembre a febrero salvo que el tramo tenga
  // calzada. Es la regla que sostiene la trashumancia (docs/03 §3.7.2).
  "puertos": [
    {
      "nombre": "Puerto de Piqueras",
      "entre": ["cameros", "tierra-de-soria"],
      "altitud": 1710,
      "cierre": "invierno",
      "nota": "Paso histórico entre el Duero y el Ebro; cerrado por nieve buena parte del invierno.",
    },
    {
      "nombre": "Somosierra",
      "entre": ["ayllon", "sierra-norte-de-madrid"],
      "altitud": 1444,
      "cierre": "invierno",
      "nota": "La puerta de Castilla la Vieja a la Nueva por el este del Guadarrama.",
    },
    {
      "nombre": "Puerto de Navacerrada",
      "entre": ["sierra-de-guadarrama", "tierra-de-segovia"],
      "altitud": 1858,
      "cierre": "invierno",
      "nota": "El paso más corto entre Segovia y Madrid, y el primero en cerrarse cada año.",
    },
    {
      "nombre": "Alto del León",
      "entre": ["sierra-de-guadarrama", "tierra-de-cebreros"],
      "altitud": 1511,
      "cierre": "invierno",
      "nota": "El puerto de Guadarrama hacia el valle del Alberche, camino de Ávila.",
    },
    {
      "nombre": "Puerto de Cotos",
      "entre": ["sierra-norte-de-madrid", "tierra-de-segovia"],
      "altitud": 1830,
      "cierre": "invierno",
      "nota": "Paso de Lozoya a Valsaín por la cuerda alta; nieve de noviembre a abril.",
    },
    {
      "nombre": "Puerto de Pajares",
      "entre": ["montanya-central-asturiana", "montanya-de-luna"],
      "altitud": 1379,
      "cierre": "invierno",
      "nota": "El único paso cómodo entre Asturias y la meseta, y aun así cerrado medio invierno.",
    },
    {
      "nombre": "Puerto de Leitariegos",
      "entre": ["babia-y-laciana", "valle-del-narcea"],
      "altitud": 1525,
      "cierre": "invierno",
      "nota": "Camino de vaqueiros entre Laciana y el Narcea, con venta y hospital en lo alto.",
    },
    {
      "nombre": "Puerto de Piedrafita",
      "entre": ["o-bierzo", "os-ancares"],
      "altitud": 1109,
      "cierre": "invierno",
      "nota": "Por donde el camino francés entra en Galicia, subiendo a O Cebreiro.",
    },
    {
      "nombre": "Puerto del Manzanal",
      "entre": ["maragateria", "o-bierzo"],
      "altitud": 1230,
      "cierre": "ninguno",
      "nota": "Paso de Astorga al Bierzo por los Montes de León; duro, pero rara vez intransitable.",
    },
    {
      "nombre": "Portillo de Padornelo",
      "entre": ["sanabria", "valdeorras"],
      "altitud": 1360,
      "cierre": "invierno",
      "nota": "La raya de Sanabria con Galicia, entre la sierra Segundera y A Gudiña.",
